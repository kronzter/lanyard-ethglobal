# Copy to .env and fill it in locally. .env is git-ignored and the pre-commit hook rejects it.
# This file lists names only; never put a real value here.

# ── Public: Expo inlines every EXPO_PUBLIC_* value into the app bundle ──
# Only feature flags and read-only, app-restricted RPC URLs/keys (treated as public, rotated if abused).
# Never a signing, operator or decryption key.
EXPO_PUBLIC_LANYARD_ENS=sepolia
EXPO_PUBLIC_LANYARD_ROUTER=stub
# rabdi (testnet) or fake (development only: an in-app Arkiv on the fixture event timeline)
EXPO_PUBLIC_LANYARD_ARKIV=rabdi
EXPO_PUBLIC_SEPOLIA_RPC_URL=
EXPO_PUBLIC_RABDI_RPC_URL=
EXPO_PUBLIC_RABDI_ACCESS_KEY=
EXPO_PUBLIC_REOWN_PROJECT_ID=

# ── Local only: deploy, seed, capture and freeze CLIs. Never prefix these with EXPO_PUBLIC_. ──
LANYARD_ENS=sepolia
LANYARD_RESULTS=mock
SEPOLIA_RPC_URL=
RABDI_RPC_URL=
RABDI_ACCESS_KEY=
ORGANIZER_PRIVATE_KEY=
RESULTS_PRIVATE_KEY=
DESK_WALLET_PRIVATE_KEY=
SCORE_DECRYPTION_KEY=

# ── P0.6 spike only: a Rabdi test key holding a little tGLM ──
RABDI_SPIKE_PRIVATE_KEY=

# ── Demo personas (fixtures/personas.json): local seed and e2e scripts only ──
# Leave empty unless you run those scripts. Mock addresses come from the public test mnemonic.
