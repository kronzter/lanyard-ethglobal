{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_LANYARD_ROUTER": "grid",
        "EXPO_PUBLIC_LANYARD_ENS": "sepolia",
        "EXPO_PUBLIC_LANYARD_ARKIV": "rabdi"
      }
    }
  }
}
