{
  "name": "lanyard",
  "version": "0.0.0",
  "private": true,
  "description": "Event OS for hackathons on ENSv2 (Sepolia) and Arkiv (Rabdi): one Expo dApp for Android and web.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "app:dev-apk": "eas build --platform android --profile development",
    "app:apk": "eas build --platform android --profile preview",
    "app:dev-apk:local": "eas build --platform android --profile development --local",
    "app:apk:local": "eas build --platform android --profile preview --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "prepare": "husky",
    "secret-scan": "node scripts/secret-scan/cli.mjs --staged",
    "secret-scan:all": "node scripts/secret-scan/cli.mjs --all",
    "forge:install": "cd contracts && forge soldeer install",
    "forge:fmt": "forge fmt --root contracts --check",
    "forge:test": "forge test --root contracts",
    "lanyard": "tsx cli/index.ts",
    "web:export": "expo export --platform web --output-dir dist",
    "ci:local": "pnpm secret-scan:all && pnpm lint && pnpm typecheck && pnpm test && pnpm vectors:browser && pnpm forge:install && pnpm forge:fmt && pnpm forge:test && pnpm web:export && pnpm smoke:web",
    "smoke:web": "node scripts/smoke-web-deeplink.mjs",
    "venue:mumbai": "tsx --tsconfig tsconfig.json scripts/build-venue-mumbai.mts",
    "vectors:browser": "node scripts/vectors-browser.mjs",
    "arkiv:schema": "tsx scripts/arkiv-schema.ts && prettier --write arkiv/schema.md",
    "rules:version": "tsx scripts/rules-version.ts",
    "e2e:i2": "LANYARD_I2=1 vitest run e2e/i2.test.ts"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "1.11.1",
    "@arkiv-network/sdk": "1.0.1",
    "@expo/metro-runtime": "58.0.17",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@reown/appkit-react-native": "2.0.6",
    "@reown/appkit-wagmi-react-native": "2.0.6",
    "@tanstack/react-query": "5.106.1",
    "@walletconnect/react-native-compat": "2.26.0",
    "expo": "58.0.23",
    "expo-application": "58.1.2",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.18",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "2.1.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "viem": "2.57.16",
    "wagmi": "2.19.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scure/bip39": "2.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "serve-handler": "6.1.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@reown/appkit-adapter-wagmi>@wagmi/connectors": "6.2.0",
      "valtio@2.1.7": "2.1.8"
    }
  }
}
