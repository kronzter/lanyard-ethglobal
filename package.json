{
  "name": "lanyard",
  "version": "0.0.0",
  "private": true,
  "description": "Event OS for hackathons on ENSv2 (Sepolia) and Arkiv (Rabdi): one Expo dApp for Android and web.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "prepare": "husky",
    "secret-scan": "node scripts/secret-scan/cli.mjs --staged",
    "secret-scan:all": "node scripts/secret-scan/cli.mjs --all",
    "forge:install": "cd contracts && forge soldeer install",
    "forge:fmt": "forge fmt --root contracts --check",
    "forge:test": "forge test --root contracts",
    "lanyard": "tsx cli/index.ts",
    "web:export": "expo export --platform web --output-dir dist",
    "ci:local": "pnpm secret-scan:all && pnpm lint && pnpm typecheck && pnpm test && pnpm forge:install && pnpm forge:fmt && pnpm forge:test && pnpm web:export && pnpm smoke:web",
    "smoke:web": "node scripts/smoke-web-deeplink.mjs"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "1.11.1",
    "@expo/metro-runtime": "58.0.17",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scure/bip39": "2.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "serve-handler": "6.1.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
